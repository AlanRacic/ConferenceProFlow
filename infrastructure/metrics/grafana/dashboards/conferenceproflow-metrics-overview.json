  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**ConferenceProFlow · M4.3 — Metrics**  \nThis is a provisioned, local-only dashboard. Start the .NET services with metrics enabled and execute an E2E registration workflow to populate business panels.  \n**No data** is normal before instrumentation generates measurements; the Prometheus self-check should display **1** once healthy.  \nCounters count processing attempts or committed outbox transitions, **not unique business events**. Backlog gauges reflect a cached SQL sample (~30s)."
      },
      "transparent": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prometheus self-check",
      "description": "Prometheus scraping itself; expected value is 1. This does not confirm OTLP ingestion.",
      "datasource": {
        "type": "prometheus",
        "uid": "conferenceproflow-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"prometheus\"}",
          "legendFormat": "",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Registration finalizations — last 30m",
      "description": "Finalized after committed SQL update.",
      "datasource": {
        "type": "prometheus",
        "uid": "conferenceproflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(conferenceproflow_registration_finalized_total[30m]))",
          "legendFormat": "{{outcome}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Registration end-to-end finalization — p95",
