@baseUrl = https://localhost:7217

# ConferenceProFlow — Registration API
#
# Execute requests in order when testing a fresh database.
# Visual Studio reuses IDs from previous HTTP responses.
#
# Before repeating the full workflow, use a new participant
# email address to avoid duplicate registration conflicts.
#
# The current development API permits registration for
# unpublished sessions. This is not intended for production.


### Get all conferences

GET {{baseUrl}}/api/conferences


### Create a conference

# @name createConference
POST {{baseUrl}}/api/conferences
Content-Type: application/json

{
  "name": "ConferenceProFlow Summit 2027",
  "startsAtUtc": "2027-06-01T08:00:00Z",
  "endsAtUtc": "2027-06-02T18:00:00Z"
}


### Get the created conference

GET {{baseUrl}}/api/conferences/{{createConference.response.body.$.id}}


### Create a conference session

# @name createSession
POST {{baseUrl}}/api/conferences/{{createConference.response.body.$.id}}/sessions
Content-Type: application/json

{
  "title": "Building Distributed Systems with .NET",
  "startsAtUtc": "2027-06-01T10:00:00Z",
  "endsAtUtc": "2027-06-01T11:30:00Z"
}


### Get conference sessions

GET {{baseUrl}}/api/conferences/{{createConference.response.body.$.id}}/sessions


### Get the created session

GET {{baseUrl}}/api/conferences/{{createConference.response.body.$.id}}/sessions/{{createSession.response.body.$.id}}


### Create a participant

# @name createParticipant
POST {{baseUrl}}/api/participants
Content-Type: application/json

{
  "displayName": "Emily Carter",
  "email": "emily.carter@example.com"
}


### Get the created participant

GET {{baseUrl}}/api/participants/{{createParticipant.response.body.$.id}}


### Create a registration

# @name createRegistration
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantId": "{{createParticipant.response.body.$.id}}",
  "sessionId": "{{createSession.response.body.$.id}}"
}


### Get the created registration

GET {{baseUrl}}/api/registrations/{{createRegistration.response.body.$.id}}


### Attempt duplicate participant (expected: 409 Conflict)

POST {{baseUrl}}/api/participants
Content-Type: application/json

{
  "displayName": "Emily Carter",
  "email": "EMILY.CARTER@example.com"
}


### Attempt duplicate registration (expected: 409 Conflict)

POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "participantId": "{{createParticipant.response.body.$.id}}",
  "sessionId": "{{createSession.response.body.$.id}}"
}